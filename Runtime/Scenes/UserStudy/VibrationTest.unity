      _value: 50
      _propertyDefinition:
        defaultValue: 50
        min: 0
        max: 360
        tooltip: 'Inner cone angle. Range: 0 to 360.'
        label: 
    outerAngle:
      _propertyName: outerAngle
      _value: 340
      _propertyDefinition:
        defaultValue: 340
        min: 0
        max: 360
        tooltip: 'Outer cone angle. Range: 0 to 360.'
        label: 
    outerGain:
      main:
        _propertyName: main
        _value: 1
        _propertyDefinition:
          defaultValue: 1
          min: 0
          max: 1
          tooltip: 'Gain in dB outside the outer cone. Range: -96 to 0.'
